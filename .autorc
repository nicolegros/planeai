{
  "baseBranch": "main",
  "name": "github-actions[bot]",
  "email": "github-actions[bot]@users.noreply.github.com",
  "plugins": [
    "git-tag",
    "conventional-commits",
    ["upload-assets", ["./artifacts/**/*"]]
  ],
  "labels": [
    { "name": "skip-release", "releaseType": "skip" }
  ],
  "noDefaultLabels": true
}
