{
  "schema": "planeai.plugin.v1",
  "id": "jira",
  "name": "Jira",
  "version": "0.1.0",
  "host_api_version": "planeai.plugin-host.v1",
  "source_kind": "builtin",
  "backend_entrypoint": "planeai-plugin-jira",
  "capabilities": ["tasks.read", "tasks.create", "tasks.update", "storage", "sidebar.navigation"],
  "background_service": {
    "method": "jira.syncNow",
    "interval_setting": "sync_interval_ms",
    "default_interval_ms": 60000
  },
  "ui_contributions": [
    {
      "id": "preferences",
      "label": "Jira",
      "placement": "preferences",
      "entrypoint": "jira-preferences"
    },
    {
      "id": "section",
      "label": "Jira",
      "placement": "sidebar.section",
      "entrypoint": "jira-sidebar-section",
      "order": 100
    },
    {
      "id": "departed-interaction",
      "label": "Departed Jira issues",
      "placement": "interaction",
      "entrypoint": "jira-departed-interaction"
    },
    {
      "id": "dashboard",
      "label": "Dashboard",
      "placement": "main-pane",
      "entrypoint": "jira-status"
    }
  ]
}
