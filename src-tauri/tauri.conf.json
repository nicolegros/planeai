{
  "productName": "planeai",
  "version": "0.1.0",
  "identifier": "ca.nicolegros.planeai",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "bundle": {
    "icon": ["icons/icon.icns", "icons/icon.png"]
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "planeai",
        "width": 1200,
        "height": 800,
        "minWidth": 640,
        "minHeight": 480,
        "devtools": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ]
  }
}
