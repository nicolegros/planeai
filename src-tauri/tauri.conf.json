{
  "productName": "planeai",
  "version": "0.0.0",
  "identifier": "ca.nicolegros.planeai",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEI5OEQ1RDlBMjJFQ0FEN0YKUldSL3Jld2ltbDJOdVFER0I2K0k1eUFSRllQU0hlVTh3T2JzdWVPejNTVlBxcGI5eHA3Q01PV0QK",
      "endpoints": ["https://github.com/nicolegros/planeai/releases/latest/download/latest.json"],
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "icon": ["icons/icon.icns", "icons/icon.ico", "icons/icon.png"],
    "createUpdaterArtifacts": "v1Compatible",
    "externalBin": ["binaries/planeai-cli", "binaries/planeai-daemon"],
    "windows": {
      "nsis": {
        "installerHooks": "./windows/hooks.nsh"
      }
    }
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "planeai",
        "width": 1200,
        "height": 800,
        "minWidth": 640,
        "minHeight": 480,
        "devtools": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ]
  }
}
